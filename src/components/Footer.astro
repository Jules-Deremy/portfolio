---
const today = new Date();
---
 
<footer>
  <div class="footer-inner">
    <div class="footer-left">
      <span class="footer-name">Deremy Jules</span>
      <span class="footer-desc">Data Analyst · Geneva area · Available Sept 2026</span>
    </div>
    <div class="footer-links">
      <a href="https://www.linkedin.com/in/jules-deremy" target="_blank">LinkedIn</a>
      <a href="https://github.com/Jules-Deremy" target="_blank">GitHub</a>
      <a href="mailto:jules.deremy0@gmail.com">Email</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>&copy; {today.getFullYear()} Deremy Jules</span>
  </div>
</footer>
 
<style>
  footer {
    margin-top: 4em;
    padding: 2em 1.5em 2.5em;
    border-top: 1px solid rgb(var(--gray-light));
    background: var(--bg);
  }
  .footer-inner {
    max-width: 740px;
    margin: 0 auto 1.5em;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5em;
  }
  .footer-left {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .footer-name {
    font-size: 0.92em;
    font-weight: 700;
    color: rgb(var(--black));
    letter-spacing: -0.01em;
  }
  .footer-desc {
    font-size: 0.8em;
    color: rgb(var(--gray));
  }
  .footer-links {
    display: flex;
    gap: 1.2em;
    align-items: center;
  }
  .footer-links a {
    font-size: 0.85em;
    font-weight: 500;
    color: rgb(var(--gray));
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .footer-links a:hover {
    color: var(--accent);
  }
  .footer-bottom {
    max-width: 740px;
    margin: 0 auto;
    padding-top: 1.2em;
    border-top: 1px solid rgb(var(--gray-light));
    font-size: 0.78em;
    color: rgb(var(--gray));
  }
</style>