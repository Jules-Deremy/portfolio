---
import HeaderLink from './HeaderLink.astro';
---
 
<header>
  <nav>
    <a href="/" class="logo">Deremy Jules</a>
    <div class="internal-links">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/projects">Projects</HeaderLink>
      <HeaderLink href="/tools">Tools</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
      <HeaderLink href="/blog">Blog</HeaderLink>
    </div>
    <div class="social-links">
      <a href="https://www.linkedin.com/in/jules-deremy" target="_blank" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="4"/>
          <path d="M7 10v7M7 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"/>
        </svg>
      </a>
      <a href="https://github.com/Jules-Deremy" target="_blank" aria-label="GitHub">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>
      <a href="mailto:jules.deremy0@gmail.com" aria-label="Email">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2"/>
          <path d="m2 7 10 7 10-7"/>
        </svg>
      </a>
    </div>
  </nav>
</header>
 
<style>
  header {
    margin: 0;
    padding: 0 1.5em;
    background: var(--bg);
    border-bottom: 1px solid rgb(var(--gray-light));
    position: sticky;
    top: 0;
    z-index: 100;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    max-width: 870px;
    margin: 0 auto;
  }
  .logo {
    font-size: 0.95em;
    font-weight: 700;
    color: rgb(var(--black));
    text-decoration: none;
    letter-spacing: -0.01em;
    flex-shrink: 0;
  }
  .logo:hover {
    color: var(--accent);
  }
  .internal-links {
    display: flex;
    align-items: center;
    gap: 0.2em;
  }
  .internal-links a {
    padding: 0.4em 0.7em;
    font-size: 0.88em;
    font-weight: 500;
    color: rgb(var(--gray));
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.15s ease;
    border-bottom: none;
  }
  .internal-links a:hover {
    color: rgb(var(--black));
    background: rgb(var(--gray-light));
  }
  .internal-links a.active {
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
    background: var(--accent-light);
  }
  .social-links {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 6px;
    color: rgb(var(--gray));
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .social-links a:hover {
    color: var(--accent);
    background: var(--accent-light);
  }
  @media (max-width: 600px) {
    .social-links { display: none; }
    .internal-links a { padding: 0.4em 0.5em; }
  }
</style>