---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
 
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---
 
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Blog · Deremy Jules" description="Notes on data, Web3, AI and the tools I actually use." />
    <style>
      .page-hero {
        padding: 4em 0 2.5em;
      }
      .page-hero h1 {
        font-size: clamp(2em, 4vw, 2.8em);
        letter-spacing: -0.03em;
        line-height: 1.15;
        margin-bottom: 0.5em;
        color: rgb(var(--black));
      }
      .page-hero .lead {
        font-size: 1.05em;
        color: rgb(var(--gray));
        max-width: 600px;
        line-height: 1.75;
        margin: 0;
      }
      .divider {
        border: none;
        border-top: 1px solid rgb(var(--gray-light));
        margin: 2.5em 0;
      }
      .posts-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-bottom: 3em;
      }
      .post-card {
        background: var(--bg-card);
        border: 1px solid rgb(var(--gray-light));
        border-radius: 12px;
        padding: 1.6em;
        text-decoration: none;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 1em;
        align-items: center;
        transition: all 0.2s ease;
        position: relative;
        overflow: hidden;
      }
      .post-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0;
        width: 3px; height: 100%;
        background: var(--accent);
        transform: scaleY(0);
        transform-origin: bottom;
        transition: transform 0.2s ease;
      }
      .post-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--box-shadow);
        text-decoration: none;
        border-color: var(--accent-light);
      }
      .post-card:hover::before {
        transform: scaleY(1);
      }
      .post-date {
        font-size: 0.7em;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--accent);
        background: var(--accent-light);
        padding: 2px 9px;
        border-radius: 20px;
        display: inline-block;
        margin-bottom: 0.6em;
      }
      .post-card h2 {
        font-size: 1.05em;
        font-weight: 700;
        color: rgb(var(--black));
        margin: 0 0 0.4em;
        letter-spacing: -0.01em;
        line-height: 1.3;
      }
      .post-card p {
        font-size: 0.88em;
        color: rgb(var(--gray));
        margin: 0;
        line-height: 1.6;
      }
      .post-arrow {
        font-size: 1em;
        color: rgb(var(--gray));
        transition: transform 0.2s;
        flex-shrink: 0;
      }
      .post-card:hover .post-arrow {
        transform: translate(2px, -2px);
        color: var(--accent);
      }
      .empty-state {
        text-align: center;
        padding: 4em 0;
        color: rgb(var(--gray));
        font-size: 0.95em;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
 
      <section class="page-hero">
        <h1>Blog</h1>
        <p class="lead">
          Where I write about what I'm building, what I'm learning, and the
          rabbit holes I fall into. Posted whenever I have something worth saying.
        </p>
      </section>
 
      <hr class="divider" />
 
      {posts.length === 0 ? (
        <div class="empty-state">Nothing published yet. Drafts in progress.</div>
      ) : (
        <div class="posts-list">
          {posts.map((post) => (
            <a href={`/blog/${post.id}/`} class="post-card">
              <div>
                <span class="post-date">
                  <FormattedDate date={post.data.pubDate} />
                </span>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </div>
              <span class="post-arrow">↗</span>
            </a>
          ))}
        </div>
      )}
 
    </main>
    <Footer />
  </body>
</html>